# Huella Delfos
HUELLA_SUPABASE_URL=
HUELLA_SUPABASE_ANON_KEY=
HUELLA_SUPABASE_SERVICE_ROLE_KEY=
HUELLA_INTERVIEWEES_TABLE=interviewees
HUELLA_SESSIONS_TABLE=sessions
HUELLA_VISITORS_TABLE=visitors

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MACHINE_DETECTION=Enable
TWILIO_MACHINE_DETECTION_TIMEOUT=20
TWILIO_ASYNC_AMD=true
TWILIO_CONVERSATION_LANGUAGE=es-US
TWILIO_TTS_PROVIDER=ElevenLabs
TWILIO_TTS_VOICE=Andrea
TWILIO_TTS_MODEL=eleven_flash_v2_5
TWILIO_TTS_SPEED=0.95
TWILIO_TTS_STABILITY=0.50
TWILIO_TTS_SIMILARITY_BOOST=0.70
TWILIO_TRANSCRIPTION_PROVIDER=Google
TWILIO_SPEECH_MODEL=telephony
TWILIO_SPEECH_TIMEOUT=3
TWILIO_SPEECH_HINTS=alo,bueno,hola,buenos dias,si,no,diga,digame
TWILIO_ACTION_ON_EMPTY_RESULT=true
TWILIO_PROFANITY_FILTER=false
TWILIO_RECORDING_ENABLED=false
TWILIO_RECORDING_CHANNELS=dual
TWILIO_RECORDING_STATUS_CALLBACK_EVENTS=in-progress completed
TWILIO_RECORDING_ANNOUNCEMENT=Hola, buenos dias. Le informamos que esta llamada sera grabada con fines de calidad y seguridad. Al continuar en la linea, usted acepta la grabacion y el tratamiento de sus datos personales conforme a nuestra politica de proteccion de datos.

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_SPEAKING_STYLE=Habla en espanol latinoamericano neutro y evita acento rioplatense

# Runtime
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://your-public-backend.example.com
TWILIO_VOICE_MODE=conversation_relay
CORS_ALLOW_ORIGINS=*

# Optional Vercel runtime fallbacks
VERCEL_URL=
VERCEL_ENV=
VERCEL_PROJECT_PRODUCTION_URL=

# Optional audio storage aliases
AUDIO_STORAGE_ENABLED=false
AUDIO_STORAGE_URL=
AUDIO_STORAGE_ANON_KEY=
AUDIO_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUDIO_STORAGE_BUCKET=audio-recordings



