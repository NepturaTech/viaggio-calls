# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MACHINE_DETECTION=Enable
TWILIO_MACHINE_DETECTION_TIMEOUT=20
TWILIO_ASYNC_AMD=true
TWILIO_CONVERSATION_LANGUAGE=es-US
TWILIO_TTS_PROVIDER=ElevenLabs
TWILIO_TTS_VOICE=Andrea
TWILIO_TTS_MODEL=eleven_flash_v2_5
TWILIO_TTS_SPEED=0.95
TWILIO_TTS_STABILITY=0.50
TWILIO_TTS_SIMILARITY_BOOST=0.70
TWILIO_TRANSCRIPTION_PROVIDER=Google
TWILIO_SPEECH_MODEL=telephony

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_SPEAKING_STYLE=Habla en espanol latinoamericano neutro y evita acento rioplatense

# Runtime
FFMPEG_PATH=
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://your-backend.azurewebsites.net
TWILIO_VOICE_MODE=conversation_relay
