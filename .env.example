# Data source
DATA_SOURCE_MODE=manual

# Lovable Cloud (primary project database)
LOVABLE_CLOUD_URL=
LOVABLE_CLOUD_ANON_KEY=
LOVABLE_CLOUD_SERVICE_ROLE_KEY=
LOVABLE_WHITELIST_TABLE=whitelist
LOVABLE_USER_ROLES_TABLE=user_roles
LOVABLE_CALL_PATIENTS_TABLE=call_patients
LOVABLE_CALL_LOGS_TABLE=call_logs
LOVABLE_CALL_ARTIFACTS_TABLE=call_artifacts
LOVABLE_CALL_APPOINTMENTS_TABLE=call_appointments
LOVABLE_CALL_HOSPITALS_TABLE=call_hospitals
LOVABLE_CALL_SCRIPTS_TABLE=call_scripts
LOVABLE_CALL_SETTINGS_TABLE=call_settings
LOVABLE_VISITAS_CAMPO_TABLE=visitas_campo

# External Supabase - Viaggio
EXTERNAL_VIAGGIO_URL=
EXTERNAL_VIAGGIO_ANON_KEY=
EXTERNAL_VIAGGIO_SERVICE_ROLE_KEY=
EXTERNAL_VIAGGIO_PACIENTES_TABLE=pacientes
EXTERNAL_VIAGGIO_FOOD_ENTRIES_TABLE=food_entries
EXTERNAL_VIAGGIO_CONVERSACIONES_TABLE=conversaciones
EXTERNAL_VIAGGIO_MEAL_PATTERNS_TABLE=meal_patterns
EXTERNAL_VIAGGIO_EVALML_TABLE=evalml
EXTERNAL_VIAGGIO_DATA_STEP_TABLE=data_step

# Huella Delfos
HUELLA_SUPABASE_URL=
HUELLA_SUPABASE_ANON_KEY=
HUELLA_SUPABASE_SERVICE_ROLE_KEY=
HUELLA_INTERVIEWEES_TABLE=interviewees
HUELLA_SESSIONS_TABLE=sessions
HUELLA_VISITORS_TABLE=visitors

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MACHINE_DETECTION=Enable
TWILIO_MACHINE_DETECTION_TIMEOUT=20
TWILIO_ASYNC_AMD=true
TWILIO_CONVERSATION_LANGUAGE=es-US
TWILIO_TTS_PROVIDER=ElevenLabs
TWILIO_TTS_VOICE=Andrea
TWILIO_TTS_MODEL=eleven_flash_v2_5
TWILIO_TTS_SPEED=0.95
TWILIO_TTS_STABILITY=0.50
TWILIO_TTS_SIMILARITY_BOOST=0.70
TWILIO_TRANSCRIPTION_PROVIDER=Google
TWILIO_SPEECH_MODEL=telephony

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_SPEAKING_STYLE=Habla en espanol latinoamericano neutro y evita acento rioplatense

# Runtime
FFMPEG_PATH=
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://your-public-backend.example.com
TWILIO_VOICE_MODE=conversation_relay
CORS_ALLOW_ORIGINS=*

# Optional Vercel runtime fallbacks
VERCEL_URL=
VERCEL_ENV=
VERCEL_PROJECT_PRODUCTION_URL=
